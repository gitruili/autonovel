# LLM provider: anthropic | minimax
AUTONOVEL_LLM_PROVIDER=minimax

# Anthropic API key (used when AUTONOVEL_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# MiniMax API key (used when AUTONOVEL_LLM_PROVIDER=minimax)
MINIMAX_API_KEY=your-minimax-api-key-here

# Writer model (used for drafting and revision)
AUTONOVEL_WRITER_MODEL=MiniMax-M2.7

# Judge model (used for evaluation — should differ from writer)
AUTONOVEL_JUDGE_MODEL=MiniMax-M2.7

# Review model (deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=MiniMax-M2.7

# API base URL (optional override; MiniMax China default shown)
AUTONOVEL_API_BASE_URL=https://api.minimaxi.com/anthropic

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
